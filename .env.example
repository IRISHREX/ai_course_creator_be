DATABASE_URL=mongodb://127.0.0.1:27017/ai_course_creator
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
# The Vite frontend uses port 8080 in development, so keep the local API on 8081.
PORT=8081
JSON_BODY_LIMIT=10mb
CORS_ORIGIN=http://localhost:5173,http://localhost:8080

# Google Gemini API
GOOGLE_AI_API_KEY=

# Bootstrap super admin (matching email gets admin + super_admin roles on signup)
SUPER_ADMIN_EMAILS=admin@example.com
