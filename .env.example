DATABASE_URL=mongodb+srv://username:password@cluster.mongodb.net/ignouprep?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
PORT=5000
JSON_BODY_LIMIT=10mb
CORS_ORIGIN=http://localhost:5173,http://localhost:8080,http://192.168.56.1:8080,https://ignouprep.lovable.app

# Google Gemini API
GOOGLE_AI_API_KEY=

# Bootstrap super admin (matching email gets admin + super_admin roles on signup)
SUPER_ADMIN_EMAILS=admin@example.com

# AI Key Encryption
AI_KEY_ENCRYPTION_SECRET=replace-with-a-long-random-secret-for-encryption
AI_KEY_LEGACY_SECRETS=
